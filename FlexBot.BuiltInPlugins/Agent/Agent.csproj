<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentPlugin</RootNamespace>
    <AssemblyName>Agent</AssemblyName>
    <NoWarn>OPENAI001</NoWarn>
    <!-- 输出到宿主 bin 的 plugins/Agent/，运行时由宿主加载 -->
    <OutDir>..\..\FlexBot\bin\$(Configuration)\net10.0\plugins\Agent\</OutDir>
    <!-- 库项目默认不拷贝 NuGet 程序集，插件目录必须自带全部依赖 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 契约层：引用 FlexBot.Abstractions（宿主与全部插件共享同一份契约程序集，不再依赖宿主 exe） -->
    <ProjectReference Include="..\..\FlexBot.Abstractions\FlexBot.Abstractions.csproj" ReferenceOutputAssembly="true" ExcludeAssets="runtime" />

    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.17.0" />
    <ProjectReference Include="..\..\FlexBot.OneBotLib\FlexBot.OneBotLib.csproj" Private="false" />
  </ItemGroup>
  <!-- 宿主已提供的程序集不随插件分发（运行时 PluginLoadContext 回落宿主 ALC 共享）：删副本防膨胀/防版本错乱 -->
  <Target Name="StripHostAssemblies" AfterTargets="Build">
    <ItemGroup>
      <HostDup Include="$(OutDir)FlexBot.dll;$(OutDir)FlexBot.exe;$(OutDir)FlexBot.pdb;$(OutDir)FlexBot.deps.json;$(OutDir)FlexBot.runtimeconfig.json;$(OutDir)FlexBot.Abstractions.dll;$(OutDir)FlexBot.Abstractions.pdb;$(OutDir)OneBotLib.dll;$(OutDir)OneBotLib.pdb;$(OutDir)Photino.NET.dll" />
    </ItemGroup>
    <Delete Files="@(HostDup)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)runtimes" ContinueOnError="true" />
  </Target>
</Project>
