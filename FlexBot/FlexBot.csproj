<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinExe：进程天生没有控制台窗口（官方 Photino 示例的做法）。需要控制台时由 ConsoleWindow.EnsureConsole() 按需开通 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FlexBot</RootNamespace>
    <AssemblyName>FlexBot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 原生应用窗口（Photino + WebView2）。仅 Windows/macOS/Linux 桌面环境使用；
         若系统没有可用的图形界面或 WebView2 运行时，宿主会自动改走"控制台 + 浏览器"的 WebUI 形态。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <!-- csx 插件：内存编译用户源码（只宿主需要，插件与脚本无需携带编译器） -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约层已剥离为独立程序集 FlexBot.Abstractions（命名空间 FlexBot.PluginApi 不变）：
         宿主与插件都只共享这一份契约，插件不再引用宿主 exe -->
    <ProjectReference Include="..\FlexBot.Abstractions\FlexBot.Abstractions.csproj" />
    <ProjectReference Include="..\FlexBot.OneBotLib\FlexBot.OneBotLib.csproj" />
    <ProjectReference Include="..\FlexBot.OfficialBot\FlexBot.OfficialBot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebUI 静态资源：直接输出到 <输出目录>/WebUi/（不再内嵌进 DLL）。
         好处：改完 CSS/JS 刷新浏览器即生效，无需重建宿主、无需重启；发布包也随之带上该目录。
         注意 WebUi.UiAssets 里仍需按顺序登记（/app.js、/app.css 是把这些文件按序拼接后吐出的），
         启动时会校验"磁盘上有但清单里没有"的文件并警告。 -->
    <Content Include="WebUi\**\*.html;WebUi\**\*.css;WebUi\**\*.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单元测试需要访问宿主内部类型（HostSettings / MessageDedup / PluginManager 等） -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FlexBot.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Photino 的原生层通过 LoadLibrary("WebView2Loader.dll") 取 WebView2 加载器：该调用走 Windows 默认
    搜索路径（应用目录 + 系统目录 + PATH），**不会**去 runtimes/<rid>/native/ 找。带 RID 的自包含发布
    本来就把原生库放在 exe 旁，所以正常；而无 RID 的普通构建只把原生库放在 runtimes 子目录里，
    于是出现"窗口能开、画面纯黑、WebView2 环境创建失败、连一个页面请求都没有"。这里构建后复制到 exe 旁。
  -->
  <PropertyGroup>
    <_PhotinoWinRid Condition="'$(PlatformTarget)' == 'arm64'">win-arm64</_PhotinoWinRid>
    <_PhotinoWinRid Condition="'$(_PhotinoWinRid)' == ''">win-x64</_PhotinoWinRid>
  </PropertyGroup>

  <Target Name="CopyPhotinoNatives" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <PhotinoNativeDll Include="$(OutDir)runtimes\$(_PhotinoWinRid)\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PhotinoNativeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
